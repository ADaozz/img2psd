# 复制为 .env（chmod 600）。命令行环境变量优先于本文件。

# 生图后端：qwen（千问多模态）/ api（Images API）/ codex
L2D_IMAGE_BACKEND=qwen
L2D_IMAGE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
L2D_IMAGE_MODEL=qwen-image-3.0-pro
DASHSCOPE_API_KEY=

# 放大后端：local（Lanczos，默认）/ codex
L2D_UPSCALE_BACKEND=local

# 可选：关闭 .env 加载
# L2D_NO_DOTENV=1
