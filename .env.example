# 复制为 .env（chmod 600）。命令行环境变量优先于本文件。

# 生图后端：apiyi（API易图片编辑）/ api（Images API）/ codex
L2D_IMAGE_BACKEND=apiyi
L2D_IMAGE_MODEL=gpt-image-2.5-sunburst

# API易图生图。模型：gemini-nano-banana-2.1、gpt-image-2.5-sunburst、gpt-image-2.5-flare
APIYI_API_KEY=
# APIYI_BASE_URL=https://api.apiyi.com
# APIYI_TIMEOUT_MS=300000

# 放大后端：local（Lanczos，默认）/ codex
L2D_UPSCALE_BACKEND=local

# 可选：关闭 .env 加载
# L2D_NO_DOTENV=1

# 可选：仅 review run 的 API 审核需要；默认现有 Agent 审核无需填写
# 独立视觉理解模型（必须支持多图输入、文本输出；不能填 Sunburst/Flare）
L2D_REVIEW_MODEL=
# L2D_REVIEW_TIMEOUT_MS=300000
# 服务不支持 response_format 时显式使用 prompt，仍严格验证 JSON
# L2D_REVIEW_JSON_MODE=prompt
