# 复制为 .env（chmod 600）。命令行环境变量优先于本文件。

# 生图后端：qwen（千问多模态）/ apiyi（API易图片编辑）/ api（Images API）/ codex
# qwen-image-3 与下面三个编辑模型共用 l2d imagegen，用 --model 或 --task 选择。
L2D_IMAGE_BACKEND=qwen
L2D_IMAGE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
L2D_IMAGE_MODEL=qwen-image-3.0-pro
DASHSCOPE_API_KEY=

# API易图生图。模型：gemini-nano-banana-2.1、gpt-image-2.5-sunburst、gpt-image-2.5-flare
APIYI_API_KEY=
# APIYI_BASE_URL=https://api.apiyi.com
# APIYI_TIMEOUT_MS=300000

# 放大后端：local（Lanczos，默认）/ codex
L2D_UPSCALE_BACKEND=local

# 可选：关闭 .env 加载
# L2D_NO_DOTENV=1
